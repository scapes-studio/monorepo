# Kamal Secrets Configuration
# These are read from environment variables. Set them before running kamal commands:
#
#   export KAMAL_REGISTRY_PASSWORD="your-docker-hub-token"
#
# Or source from a local .env file (not committed to git):
#   source .env.production && kamal deploy

# Docker Hub access token (create at https://hub.docker.com/settings/security)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Public RPC URLs for client-side blockchain calls
NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPC1=$NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPC1
NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPC2=$NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPC2
NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPC3=$NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPC3

# WalletConnect project ID
NUXT_PUBLIC_EVM_WALLET_CONNECT_PROJECT_ID=$NUXT_PUBLIC_EVM_WALLET_CONNECT_PROJECT_ID
